<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio - Lista de Tareas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/Css/sidebar.css">
    <link rel="stylesheet" href="/Css/inicio.css">
</head>
<body class="d-flex">
    <%- include("partials/sidebar") %>

    <main class="flex-grow-1 p-4" style="margin-left: 250px;">
        <h1 class="mb-3">Hola, <%= usuario.nombre %> 👋</h1>
        <p class="text-muted">Bienvenido a tu panel general de tareas.</p>

        <div class="row mt-4">
            <div class="col-md-6 mb-3">
                <div class="card bg-warning text-dark p-3 shadow-sm">
                    <h3><%= pendientes %></h3>
                    <p class="mb-0">Tareas Pendientes / En Progreso</p>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card bg-success text-white p-3 shadow-sm">
                    <h3><%= completadas %></h3>
                    <p class="mb-0">Tareas Completadas</p>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="/tareas" class="btn btn-primary">Ir a mis tareas</a>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>